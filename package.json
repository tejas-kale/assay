{
  "name": "assay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:node && npm run lint:py && npm run test:py && npm run coverage-bar",
    "test": "npm run test:node && npm run test:py",
    "test:node": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='src/core/**' --test-coverage-include='src/server/**' --test-coverage-include='src/hooks/**' --test-coverage-exclude='**/*.test.ts' --test-reporter=dot --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 --test-reporter=spec \"tests/integration/**/*.test.ts\"",
    "test:py": "cd python && ../scripts/py.sh pytest -q -p no:cacheprovider -n auto --cov --cov-report=json:../coverage/python.json",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings 0 --no-error-on-unmatched-pattern src scripts tests",
    "lint:py": "scripts/py.sh ruff check python --quiet",
    "coverage-bar": "node scripts/coverage-bar.ts",
    "postinstall": "node scripts/postinstall.mjs && node scripts/build-server.mjs",
    "package": "electron-vite build && npm run build:server && electron-builder --mac --dir --config.mac.identity=- --config.mac.hardenedRuntime=false",
    "install-app": "npm run package && rm -rf /Applications/Assay.app && ditto dist/mac-arm64/Assay.app /Applications/Assay.app",
    "build:server": "node scripts/build-server.mjs",
    "migrate:root": "node scripts/migrate-root.ts",
    "migrate:notes": "node scripts/migrate-notes.ts",
    "import:denote": "node scripts/import-denote.ts",
    "release:build": "electron-vite build && npm run build:server && electron-builder --mac dmg zip --arm64 --publish never --config.forceCodeSigning=true"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@replit/codemirror-vim": "^6.4.0",
    "electron-updater": "^6.8.11",
    "ghostty-web": "^0.4.0",
    "mermaid": "^12.2.0",
    "node-pty": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql-formatter": "^15.9.0"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "playwright-core": "^1.65.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.tejaskale.assay",
    "productName": "Assay",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": true
    },
    "extraResources": [
      {
        "from": "plugin",
        "to": "backend/plugin",
        "filter": [
          "**/*",
          ".claude-plugin/**"
        ]
      },
      {
        "from": "out/server",
        "to": "backend/out/server",
        "filter": [
          "index.mjs"
        ]
      },
      {
        "from": "out/hooks",
        "to": "backend/out/hooks",
        "filter": [
          "*.mjs"
        ]
      },
      {
        "from": "python",
        "to": "backend/python",
        "filter": [
          "analysis_*.py",
          "pyproject.toml",
          "uv.lock"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "tejas-kale",
      "repo": "assay",
      "private": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
