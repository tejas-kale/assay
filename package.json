{
  "name": "assay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "postinstall": "node scripts/postinstall.mjs && node scripts/build-server.mjs",
    "package": "npm run build:server && electron-vite build && electron-builder --mac --dir",
    "install-app": "npm run package && rm -rf /Applications/Assay.app && ditto dist/mac-arm64/Assay.app /Applications/Assay.app",
    "build:server": "node scripts/build-server.mjs",
    "migrate:root": "node scripts/migrate-root.ts",
    "migrate:notes": "node scripts/migrate-notes.ts",
    "import:denote": "node scripts/import-denote.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@replit/codemirror-vim": "^6.4.0",
    "ghostty-web": "^0.4.0",
    "mermaid": "^12.2.0",
    "node-pty": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql-formatter": "^15.9.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.tejaskale.assay",
    "productName": "Assay",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "target": "dir",
      "hardenedRuntime": false
    }
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
